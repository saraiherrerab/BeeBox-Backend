datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id             String   @id @default(uuid())
  name           String
  email          String   @unique
  password       String
  phone          String?
  suiteCode      String?  @unique
  role           String   @default("client")
  active         Boolean  @default(true)
  disabledReason String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  shipments     Shipment[]
  prealertas    Prealerta[]
  pickups       Pickup[]
  branchPickups BranchPickup[]
  notifications Notification[]
}

model Shipment {
  trackingCode      String   @id
  userId            String?
  user              User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  senderName        String
  senderCity        String
  recipientName     String
  recipientCity     String
  recipientAddress  String
  serviceType       String
  weightKg          Float
  dimensions        String
  estimatedDelivery String
  currentStatus     String   @default("En el origen")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  events        TrackingEvent[]
  prealerta     Prealerta?
  branchPickups BranchPickup[]
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("info")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model TrackingEvent {
  id          String   @id @default(uuid())
  shipmentId  String
  shipment    Shipment @relation(fields: [shipmentId], references: [trackingCode], onDelete: Cascade)
  timestamp   DateTime @default(now())
  location    String
  status      String
  title       String
  description String
}

model Prealerta {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  store           String
  trackingNumber  String
  description     String
  amountPaid      Float
  receiptFileName String?
  status          String    @default("Prealertado")
  warehouseGuide  String?
  shipmentId      String?   @unique
  shipment        Shipment? @relation(fields: [shipmentId], references: [trackingCode], onDelete: SetNull)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model FleetVehicle {
  id       String  @id @default(uuid())
  name     String
  category String
  capacity String
  volume   String
  features String
  imageUrl String?
  active   Boolean @default(true)

  pickups Pickup[]
  routes  Route[]
}

model Pickup {
  id                 String        @id @default(uuid())
  pickupCode         String        @unique
  userId             String
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  senderName         String
  senderPhone        String
  senderAddress      String
  senderCity         String
  boxCount           Int           @default(1)
  totalWeightKg      Float         @default(1.0)
  containElectronics Boolean       @default(false)
  recipientName      String
  recipientPhone     String
  recipientAddress   String
  recipientCity      String
  pickupDate         String
  timeSlot           String
  vehicleId          String?
  vehicle            FleetVehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  status             String        @default("PENDIENTE")
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
}

model BranchPickup {
  id            String    @id @default(uuid())
  pinCode       String    @unique
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  shipmentId    String
  shipment      Shipment  @relation(fields: [shipmentId], references: [trackingCode], onDelete: Cascade)
  branchName    String
  scheduledDate String
  scheduledTime String
  status        String    @default("PROGRAMADO")
  deliveredAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Route {
  id         String        @id @default(uuid())
  name       String
  originCity String
  destCity   String
  vehicleId  String?
  vehicle    FleetVehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  status     String        @default("ACTIVA")
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

model RateConfig {
  id            String   @id @default(uuid())
  serviceType   String   @unique
  basePrice     Float
  pricePerKg    Float
  insuranceRate Float    @default(0.02)
  active        Boolean  @default(true)
  updatedAt     DateTime @updatedAt
}

model CMSContent {
  id          String   @id @default(uuid())
  type        String
  title       String
  description String
  imageUrl    String?
  linkUrl     String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
}



